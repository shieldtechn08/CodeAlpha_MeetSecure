PORT=3000
JWT_SECRET=change_this_secret_in_production

# Clé de chiffrement des fichiers au repos (AES-256-GCM), 32 octets en hexadécimal (64 caractères).
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si absente, une clé est dérivée de JWT_SECRET (dépannage uniquement, à éviter en production).
FILE_ENCRYPTION_KEY=
